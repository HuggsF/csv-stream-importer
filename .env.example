# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# true = human readable logs (pino-pretty, dev only)
LOG_PRETTY=false
# Hard deadline for graceful shutdown (SIGTERM/SIGINT)
SHUTDOWN_TIMEOUT_MS=30000

# ── Database (MySQL 8) — required ────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=csv_importer
DB_POOL_MIN=2
DB_POOL_MAX=10
# Run pending migrations when the HTTP server starts
DB_MIGRATE_ON_START=false

# ── Import ───────────────────────────────────────────────────
# Rows per multi-row INSERT (1..10000)
IMPORT_BATCH_SIZE=1000
# A single CSV row larger than this aborts the import
CSV_MAX_ROW_BYTES=65536
# Where error reports (errors-<timestamp>.csv) are written
ERROR_REPORT_DIR=./output

# ── HTTP upload API (POST /api/import) ───────────────────────
UPLOAD_DIR=./uploads
# 200 MB
UPLOAD_MAX_BYTES=209715200
# Imports running in parallel / waiting in the queue before answering 503
IMPORT_QUEUE_CONCURRENCY=1
IMPORT_QUEUE_MAX_PENDING=10

# ── docker-compose host ports (change if 3306/3000 are taken) ─
MYSQL_HOST_PORT=3306
APP_HOST_PORT=3000
